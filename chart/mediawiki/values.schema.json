{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "externalDatabase": {
      "type": "object",
      "required": [
        "host",
        "port",
        "database",
        "existingSecret"
      ],
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "localSettings": {
      "type": "object",
      "properties": {
        "variables": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "skins": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "extraPhp": {
          "type": "string"
        }
      }
    },
    "migration": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 15,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        }
      }
    },
    "mediawiki": {
      "type": "object",
      "properties": {
        "server": {
          "type": "string",
          "pattern": "^https?://"
        },
        "readOnly": {
          "type": "boolean"
        }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "subPath": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "adminUser": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "bitnamiImport": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "imagesSubPath": {
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"
        }
      }
    },
    "mariadb": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "auth": {
          "type": "object",
          "properties": {
            "database": {
              "type": "string",
              "minLength": 1
            },
            "username": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
